#!/usr/bin/env sh

# ---------------------------------------------------------------------------
# Scripting addition
# Requires the yabai sudoers entry to allow `sudo yabai --load-sa`
# without prompting for a password.
# ---------------------------------------------------------------------------

yabai -m signal --add \
    event=dock_did_restart \
    action="sudo yabai --load-sa"

sudo yabai --load-sa


# ---------------------------------------------------------------------------
# Layout
#
# One window:
#   Fills the available desktop automatically.
#
# Multiple windows:
#   Tiles using BSP with a 6px internal gap.
# ---------------------------------------------------------------------------

yabai -m config layout                  bsp

yabai -m config top_padding             0
yabai -m config bottom_padding          0
yabai -m config left_padding            0
yabai -m config right_padding           0
yabai -m config window_gap              6

yabai -m config window_placement        second_child
yabai -m config split_ratio             0.50
yabai -m config split_type              auto
yabai -m config auto_balance            on


# ---------------------------------------------------------------------------
# Window behavior
# ---------------------------------------------------------------------------

# Make yabai movement and resizing immediate.
yabai -m config window_animation_duration 0.0

# No shadows on tiled windows; retain them for floating dialogs/utilities.
yabai -m config window_shadow           float

# Do not preserve zoom states when the BSP tree changes.
# This prevents a fullscreened window from covering newly added tiles.
yabai -m config window_zoom_persist     off

# Keep windows opaque.
yabai -m config window_opacity          off

# Manage new windows on the display where macOS creates them.
yabai -m config window_origin_display   default


# ---------------------------------------------------------------------------
# Focus and mouse behavior
# ---------------------------------------------------------------------------

yabai -m config focus_follows_mouse     off
yabai -m config mouse_follows_focus     off

yabai -m config mouse_modifier          fn
yabai -m config mouse_action1           move
yabai -m config mouse_action2           resize
yabai -m config mouse_drop_action       swap


# ---------------------------------------------------------------------------
# Floating and utility-window rules
# ---------------------------------------------------------------------------

yabai -m rule --add \
    label="system-preferences" \
    app="^System Preferences$" \
    manage=off

yabai -m rule --add \
    label="system-settings" \
    app="^System Settings$" \
    manage=off

yabai -m rule --add \
    label="stats" \
    app="^Stats$" \
    manage=off \
    sticky=on

yabai -m rule --add \
    label="eqmac" \
    app="^eqMac$" \
    manage=off \
    sticky=on


# Apply the rules to windows that were already open when yabai restarted.
yabai -m rule --apply
