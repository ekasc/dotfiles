#!/Users/ekassinghchhabra/.local/share/sketchybar_lua/lua

-- SbarLua entry point. Resolves the config dir from our own path so the
-- config stays portable; the lua module lives outside the repo.
local confdir = (arg and arg[0] or ""):match("(.*/)") or (os.getenv("HOME") .. "/.config/sketchybar/")
package.path = package.path .. ";" .. confdir .. "?.lua;" .. confdir .. "?/init.lua"
package.cpath = package.cpath .. ";" .. os.getenv("HOME") .. "/.local/share/sketchybar_lua/?.so"

sbar = require("sketchybar")

-- Single instance: sbar.event_loop() below blocks forever, so every
-- `sketchybar --reload` (or hotload re-exec) would orphan the previous
-- lua runtime, leaving duplicate timers/callbacks behind. The newest
-- config therefore kills the previous runtime via a pidfile.
-- (Startup-only blocking calls are fine; the event thread starts later.)
do
  local home = os.getenv("HOME") or ""
  local pidfile = home .. "/.local/share/sketchybar_lua/config.pid"
  local me = nil
  local p = io.popen("echo $PPID 2>/dev/null")
  if p then me = p:read("*l") p:close() end
  local f = io.open(pidfile, "r")
  if f then
    local old = f:read("*l")
    f:close()
    -- Only signal a pid we are sure is numeric: a corrupt pidfile must never
    -- send a stray signal to an unrelated process.
    if old and old:match("^%d+$") and old ~= me then
      os.execute("kill " .. old .. " 2>/dev/null")
    end
  end
  if me and me:match("^%d+$") then
    f = io.open(pidfile, "w")
    if f then f:write(me) f:close() end
  end
end

-- Bundle the entire initial configuration into a single message to sketchybar
sbar.begin_config()
require("init")
sbar.hotload(false)
-- NOTE: hotload stays off because this checkout's `.pi/state/guardrails/`
-- log is appended on every agent tool call; watching the config dir would
-- re-exec this config (and rotate runtimes) constantly. Reload explicitly:
-- `sketchybar --reload` (the pidfile guard above keeps exactly one runtime).
sbar.end_config()

-- Run the event loop (without this no lua callbacks execute)
sbar.event_loop()
